public class Main {
    public static void main(String[] args) {
        int size = 5;

        for (int row = 1; row <= size; row++) {
            if (row == 3) {
                continue; /*skips printing row 3 entirely*/
            }
            for (int col = 1; col <= row; col++) {
                if (col == 4) {
                    break; /*stops the inner loop once column 4 is reached*/
                }
                System.out.print("😭 ");
            }
            System.out.println();
        }
    }
}
