import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
        int total = 0;
        int number = input.nextInt();

        while (number != -1) {
            total += number;
            number = input.nextInt();
        }

        System.out.println("Total: " + total);
    }
}
