public class Main {
    public static void main(String[] args) {
        /* true (5 + 6 = 11 > 10, and 3 < 5)*/
        System.out.println(5 + 3 * 2 > 10 && 4 - 1 < 5);

        int x = 5;
       /*12 (x++ gives 5, then ++x gives 7)*/
        System.out.println(x++ + ++x);

        /* true (&& is evaluated before ||)*/
        System.out.println(10 > 5 || 3 > 8 && 2 > 4);
    }
}
